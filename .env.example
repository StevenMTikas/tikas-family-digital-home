# Copy to .env.local and fill in real values. Never commit .env.local.

# Database
DATABASE_PATH=./db/tikas.db

# Session cookie signing (see lib/core/session) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password Entry at-rest encryption (see lib/crypto/secret-box) — MVP-level
# only, see Family_Knowledge.md. Generate with the same command as above.
PASSWORD_ENCRYPTION_KEY=

# Backup archive at-rest encryption (see lib/crypto/secret-box, lib/core/backup)
# — separate key from PASSWORD_ENCRYPTION_KEY so a leaked one doesn't expose
# the other. Generate with the same command as above.
BACKUP_ENCRYPTION_KEY=

# Local file storage for Documents/Photos uploads (see lib/storage/files)
UPLOADS_DIR=./uploads

# Backup destination (see docs/06_Admin/Backup.md). Defaults to a local
# ./backups directory (same physical disk as the app/DB — Backup.md flags
# this as an open question for a real deployment). Point this at a mounted
# external drive path for genuine protection against local disk failure.
BACKUP_DIR=./backups

# Ollama (local AI, see docs/01_System_Architecture/AI_Architecture.md)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GUARDIAN_MODEL=llama3.2:3b

# Outside frontier model for photo-to-event extraction (see Decision_Log.md #007)
# Provider not yet decided — see docs/01_System_Architecture/Decision_Log.md open decisions.
# NOT the same key as ANTHROPIC_API_KEY below — this is reserved for that
# separate, still-unbuilt feature until its own provider choice is made.
FRONTIER_MODEL_API_KEY=

# Frontier model for the Assistant's hybrid local/frontier routing (see
# AI_Architecture.md — auto-routing for non-family questions, plus
# thumbs-down escalation). Anthropic only for now; get a key at
# https://console.anthropic.com. Leave blank to disable both — the
# Assistant then stays fully local, same as before this feature existed.
ANTHROPIC_API_KEY=

# Remote access (see Security_Architecture.md — Tailscale or similar, not port-forwarding)
TAILSCALE_AUTH_KEY=

# Web Push (see docs/02_Modules/Notifications.md — Android push for MVP).
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must match VAPID_PUBLIC_KEY exactly (client needs it to subscribe).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Weather (see docs/02_Modules/Dashboard.md) — Open-Meteo, no API key needed,
# just this one household's coordinates. Leave blank to fall back to a
# placeholder location rather than fail outright.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# Email account app-password encryption (see lib/crypto/secret-box,
# docs/02_Modules/Email.md) — separate key, same reasoning as BACKUP_ENCRYPTION_KEY.
EMAIL_ENCRYPTION_KEY=

# Gmail OAuth ("Sign in with Google" for the Email module, 2026-08-02) — a
# second, Gmail-only auth path alongside the IMAP+app-password flow above;
# see docs/02_Modules/Email.md. Create a free OAuth Client ID (Web
# application) at https://console.cloud.google.com — OAuth consent screen in
# "Testing" mode with your Gmail address as a test user, enable the Gmail
# API, then add authorized redirect URIs for every host you'll reach this
# app from (e.g. http://localhost:3000/api/email/oauth/google/callback and
# your Tailscale URL equivalent — the app computes the exact redirect URI
# per-request, so any registered host works with no code change). Leave
# blank to disable — Gmail then falls back to IMAP+app-password only, same
# as every other provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
